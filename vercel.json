{
  "version": 2,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://backend-gules-gamma-15.vercel.app/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://backend-gules-gamma-15.vercel.app/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
